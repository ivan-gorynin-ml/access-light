# =============================================================================
# access-light — environment configuration template
# Copy this file to `.env` in the project root and fill in your values.
# Never commit `.env` to version control.
# =============================================================================

# --- Required ----------------------------------------------------------------

# MongoDB connection string (local or Atlas)
MONGODB_URL=mongodb://localhost:27017

# Database name (created automatically if it does not exist)
DATABASE_NAME=access_light

# Root superadmin account — created or updated on every startup
ROOT_LOGIN=root
ROOT_PASSWORD=change-me-to-a-strong-password

# JWT signing secret (required for HS256; use a long random string in production)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- Optional (sensible defaults shown) --------------------------------------

# APP_NAME=access-light
# APP_VERSION=1.0.0
# LOG_LEVEL=INFO

# COLLECTION_NAME=users
# LOGIN_ATTEMPTS_COLLECTION_NAME=login_attempts
# REVOKED_TOKENS_COLLECTION_NAME=revoked_tokens
# ACTIVITY_ATTEMPTS_COLLECTION_NAME=activity_attempts
# LOGIN_CREDENTIALS_COLLECTION_NAME=login_credentials

# LOGIN_RATE_LIMIT=30/minute

# JWT_ALGORITHM=HS256
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_EXPIRES_SECONDS=2592000

# CORS_ORIGINS=*
# CORS_ALLOW_METHODS=*
# CORS_ALLOW_HEADERS=*
# CORS_ALLOW_CREDENTIALS=false
# CORS_MAX_AGE=600
